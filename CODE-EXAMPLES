
Here are some examples of module design for the framework.
aqui tem alguns exemplos de desing dos modules pro framework.

===============================================================================================

Services:

local module1 = {
    Name = "module1",
    Type = "Service", -- Module type / Tipo do módulo
    
    Needs = {
        -- Path functions used for lazy resolution / Funções de caminho para resolução preguiçosa
        module2 = function(self, AD) return AD:Find("module2") end, 
    } -- Dependencies / Dependências
}

-- Type "Service" doesn't need a type function/O tipo "Service" não precisa de função de tipo

-- Lifecycle: Initialization phase / Fase de inicialização
function module1:_Init(AD, resolvedNeeds, shared)
    print(resolvedNeeds) -- Contains resolved dependencies / Contém as dependências resolvidas
end

-- Lifecycle: Start phase (optional) / Fase de começo (opcional)
function module1:_Start(AD, shared)
    -- Your runtime code here / Seu código de execução aqui
end

return module1


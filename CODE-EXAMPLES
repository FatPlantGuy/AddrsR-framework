Data:

local PlayerData = {
    Name = "PlayerData",
    Type = "Data", -- Module type / Tipo do módulo
    
    -- Contract requirement: must contain a Data table / Requisito do contrato: deve conter uma tabela Data
    Data = {
        BaseHealth = 100,
        WalkSpeed = 16,
    }
}

-- Type function required by the 'Data' contract / Função exigida pelo contrato Data
function PlayerData:Get()
    return self.Data
end

-- Lifecycle: Initialization phase / Fase de inicialização
function PlayerData:_Init(AD, resolvedNeeds, shared)
    -- Optional: set up initial data structures / Opcional: configurar estruturas de dados iniciais
end

-- Lifecycle: Start phase (optional) / Fase de começo (opcional)
function PlayerData:_Start(AD, shared)
    -- Your runtime code here / Seu código de execução aqui
end

return PlayerData

